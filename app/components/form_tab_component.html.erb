<div id="form-tab-component" data-form-tabs>
  <ul class="usa-button-group usa-button-group--segmented flex-row margin-bottom-4">
    <% tabs.each do |tab| %>
    <li class="usa-button-group__item display-flex flex-fill">
      <button
        id="<%= tab.button_id %>"
        type="button"
        class="usa-button usa-button--big flex-fill <%= 'usa-button--outline' unless tab.active %>"
        role="tab">
        <%= tab.label %>
      </button>
    </li>
    <% end %>
  </ul>

  <% tabs.each do |tab| %>
    <section id="<%= tab.panel_id %>" role="tabpanel" <%= "hidden" unless tab.active %>>
      <fieldset  <%= "disabled" unless tab.active %>>
        <%= tab %>
      </fieldset>
    </section>
  <% end %>
</div>
